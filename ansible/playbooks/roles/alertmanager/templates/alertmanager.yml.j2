# Fichier de configuration Alertmanager généré par Ansible (rôle alertmanager).
# Ne pas éditer directement sur le serveur : modifier le template / les variables.
{% set email_enabled = alertmanager_smtp_smarthost | length > 0 %}
{% set slack_enabled = alertmanager_slack_webhook_url | length > 0 %}
{% set receivers = [
  {'name': 'default',  'email_to': alertmanager_email_to,          'slack_channel': alertmanager_slack_channel,
   'teams_url': alertmanager_msteams_webhook_url},
  {'name': 'critical', 'email_to': alertmanager_critical_email_to, 'slack_channel': alertmanager_critical_slack_channel,
   'teams_url': alertmanager_critical_msteams_webhook_url},
] %}

global:
  resolve_timeout: {{ alertmanager_resolve_timeout }}
{% if email_enabled %}
  smtp_smarthost: {{ alertmanager_smtp_smarthost | to_json }}
  smtp_from: {{ alertmanager_smtp_from | to_json }}
{% if alertmanager_smtp_auth_username | length > 0 %}
  smtp_auth_username: {{ alertmanager_smtp_auth_username | to_json }}
  smtp_auth_password: {{ alertmanager_smtp_auth_password | to_json }}
{% endif %}
  smtp_require_tls: {{ alertmanager_smtp_require_tls | bool | to_json }}
{% endif %}

route:
  receiver: default
  group_by: {{ alertmanager_group_by | to_json }}
  group_wait: {{ alertmanager_group_wait }}
  group_interval: {{ alertmanager_group_interval }}
  repeat_interval: {{ alertmanager_repeat_interval }}
  routes:
    # Watchdog est toujours active (test de la chaîne d'alerting) :
    # visible dans l'UI mais jamais notifiée.
    - receiver: "null"
      matchers:
        - alertname="Watchdog"
    - receiver: critical
      matchers:
        - severity="critical"
      repeat_interval: {{ alertmanager_critical_repeat_interval }}

# Une alerte critique masque l'alerte warning équivalente sur la même machine
# (ex. "disque plein à 95%" masque "disque plein à 85%").
inhibit_rules:
  - source_matchers:
      - severity="critical"
    target_matchers:
      - severity="warning"
    equal: ["alertname", "instance"]

# Un receiver sans configuration est valide : les alertes sont alors visibles
# dans l'interface web mais aucune notification n'est envoyée.
receivers:
  - name: "null"
{% for r in receivers %}
  - name: {{ r.name }}
{% if email_enabled and r.email_to | length > 0 %}
    email_configs:
      - to: {{ r.email_to | to_json }}
        send_resolved: true
{% endif %}
{% if r.teams_url | length > 0 %}
    msteamsv2_configs:
      - webhook_url: {{ r.teams_url | to_json }}
        send_resolved: true
{% endif %}
{% if slack_enabled %}
    slack_configs:
      - api_url: {{ alertmanager_slack_webhook_url | to_json }}
        channel: {{ r.slack_channel | to_json }}
        send_resolved: true
{% endif %}
{% endfor %}
